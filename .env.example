# ─────────────────────────────────────────────────────────────────────────────
# WUnified local stack (docker compose) — LOCAL DEV ONLY
#
#   cp .env.example .env && docker compose up
#
# Every value here is a well-known, non-secret local default (the standard
# Supabase demo JWT secret + keys). The stack comes up with zero edits.
# NEVER reuse any of these in a deployed, shared, or production environment.
# ─────────────────────────────────────────────────────────────────────────────

# --- Postgres (service: db) -------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
# Host access:  psql postgresql://postgres:postgres@localhost:54322/postgres
# If you change POSTGRES_PASSWORD, also update
# scripts/db/init/99-local-passwords.sql (internal role passwords).

# --- JWT / API keys — shared by auth, rest, and the Expo client -----------
# JWT_SECRET signs the tokens GoTrue mints and is what PostgREST verifies with.
# ANON_KEY / SERVICE_ROLE_KEY are JWTs signed with it (Supabase's published demo
# keys). If you change JWT_SECRET you must re-sign both keys.
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZGVtbyIsImlhdCI6MTY0MTc2OTIwMCwiZXhwIjoxNzk5NTM1NjAwfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# --- GoTrue (service: auth) ----------------------------------------------
GOTRUE_SITE_URL=http://localhost:8081
GOTRUE_URI_ALLOW_LIST=*
GOTRUE_DISABLE_SIGNUP=false
# Local dev has no mail server — auto-confirm new signups so login works.
GOTRUE_MAILER_AUTOCONFIRM=true

# --- Expo web client (service: web; read by src/lib/env.ts in the browser) -
# The client hits the gateway on 54321, which routes /auth/v1 -> auth and
# everything else -> rest (PostgREST). EXPO_PUBLIC_SUPABASE_ANON_KEY must equal
# ANON_KEY above.
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
