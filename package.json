{
  "name": "wunified",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest --selectProjects unit",
    "test:watch": "jest --selectProjects unit --watch",
    "test:ci": "jest --selectProjects unit --ci --coverage --maxWorkers=2",
    "test:integration": "node scripts/test/run-integration.js",
    "test:integration:dev": "jest --selectProjects integration --runInBand",
    "dev:up": "docker compose up",
    "dev:down": "docker compose down",
    "dev:reset": "docker compose down -v && docker compose up",
    "dev:logs": "docker compose logs -f",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,cjs,ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.103.3",
    "expo": "^58.0.0",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-url-polyfill": "3.0.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.1",
    "eslint": "9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "lint-staged": "15.5.2",
    "prettier": "3.9.6",
    "react-test-renderer": "19.3.0",
    "supabase": "^2.76.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "private": true
}
